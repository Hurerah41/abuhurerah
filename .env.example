# Resend API Key for sending emails from the contact form
RESEND_API_KEY=re_your_api_key_here

# Sender email address configured in Resend (e.g. contact@yourdomain.com or onboarding@resend.dev)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# WhatsApp phone number (digits only with country code, no + sign, e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
